{
  "name": "whalego",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "description": "Dual-brain voice plugin for DSH-Go. Hear it first, read it after.",
  "license": "MIT",
  "author": "WhaleGo contributors",
  "scripts": {
    "test": "node --test",
    "test:live": "node tools/live/run.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JumpTea/WhaleGo.git"
  },
  "bugs": {
    "url": "https://github.com/JumpTea/WhaleGo/issues"
  },
  "homepage": "https://github.com/JumpTea/WhaleGo",
  "keywords": [
    "dsh-go",
    "voice",
    "tts",
    "plugin",
    "deepseek",
    "whale"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0",
    "node": ">=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "鲸语",
      "en": "WhaleGo"
    },
    "icon": "mic",
    "wants": [
      "draft",
      "message"
    ],
    "capabilities": [
      "audio"
    ],
    "contributes": {
      "composer.actions": [
        {
          "id": "whalego.ask",
          "label": {
            "zh": "鲸语",
            "en": "Whale"
          },
          "icon": "mic",
          "requires": [
            "audio"
          ]
        },
        {
          "id": "whalego.stop",
          "label": {
            "zh": "停",
            "en": "Stop"
          }
        }
      ],
      "message.actions": [
        {
          "id": "whalego.read",
          "label": {
            "zh": "朗读",
            "en": "Read"
          },
          "icon": "play"
        },
        {
          "id": "whalego.explain",
          "label": {
            "zh": "鲸语解释",
            "en": "Explain"
          },
          "icon": "chat"
        }
      ],
      "composer.strip": [
        {
          "id": "whalego.status",
          "icon": "mic",
          "text": {
            "zh": "鲸语 · 待命",
            "en": "WhaleGo · idle"
          },
          "panel": "whalego.live"
        }
      ],
      "panels": [
        {
          "id": "whalego.live",
          "title": {
            "zh": "鲸语实录",
            "en": "WhaleGo Live"
          },
          "icon": "chat",
          "placement": [
            "session.tab",
            "features"
          ]
        },
        {
          "id": "whalego.settings",
          "title": {
            "zh": "鲸语设置",
            "en": "WhaleGo Settings"
          },
          "icon": "wrench",
          "placement": [
            "features"
          ]
        },
        {
          "id": "whalego.about",
          "title": {
            "zh": "关于鲸语",
            "en": "About WhaleGo"
          },
          "icon": "sparkle",
          "placement": [
            "features"
          ]
        },
        {
          "id": "whalego.diag",
          "title": {
            "zh": "接缝诊断",
            "en": "Seam Check"
          },
          "icon": "bug",
          "placement": [
            "features"
          ]
        }
      ],
      "media": [
        {
          "id": "speech"
        }
      ]
    },
    "settings": {
      "title": {
        "zh": "鲸语",
        "en": "WhaleGo"
      },
      "fields": [
        {
          "id": "mode",
          "type": "select",
          "label": {
            "zh": "双脑模式",
            "en": "Mode"
          },
          "default": "auto",
          "options": [
            {
              "value": "auto",
              "label": {
                "zh": "自动",
                "en": "Auto"
              }
            },
            {
              "value": "dual",
              "label": {
                "zh": "总是双脑",
                "en": "Dual"
              }
            },
            {
              "value": "voice",
              "label": {
                "zh": "只语音",
                "en": "Voice only"
              }
            },
            {
              "value": "read",
              "label": {
                "zh": "朗读答案",
                "en": "Read"
              }
            }
          ]
        },
        {
          "id": "voice",
          "type": "select",
          "label": {
            "zh": "音色",
            "en": "Voice"
          },
          "default": "zh-CN-XiaoxiaoNeural",
          "options": [
            {
              "value": "zh-CN-XiaoxiaoNeural",
              "label": {
                "zh": "晓晓 · 女声",
                "en": "Xiaoxiao"
              }
            },
            {
              "value": "zh-CN-YunxiNeural",
              "label": {
                "zh": "云希 · 男声",
                "en": "Yunxi"
              }
            },
            {
              "value": "zh-CN-XiaoyiNeural",
              "label": {
                "zh": "晓伊 · 女声",
                "en": "Xiaoyi"
              }
            }
          ]
        },
        {
          "id": "rate",
          "type": "select",
          "label": {
            "zh": "语速",
            "en": "Rate"
          },
          "default": "normal",
          "options": [
            {
              "value": "slow",
              "label": {
                "zh": "慢",
                "en": "Slow"
              }
            },
            {
              "value": "normal",
              "label": {
                "zh": "正常",
                "en": "Normal"
              }
            },
            {
              "value": "fast",
              "label": {
                "zh": "快",
                "en": "Fast"
              }
            }
          ]
        },
        {
          "id": "thinkOrb",
          "type": "select",
          "label": {
            "zh": "思考时球的位置",
            "en": "Thinking dock"
          },
          "default": "corner",
          "options": [
            {
              "value": "corner",
              "label": {
                "zh": "右下角",
                "en": "Corner"
              }
            },
            {
              "value": "center",
              "label": {
                "zh": "底部中央",
                "en": "Centre"
              }
            }
          ]
        }
      ]
    }
  }
}
