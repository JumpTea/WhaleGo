{
  "name": "node-cpal",
  "version": "1.0.0",
  "description": "Node.js bindings for CPAL (Cross-Platform Audio Library)",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./backend-jack": {
      "types": "./backend-jack.d.ts",
      "require": "./backend-jack.js",
      "default": "./backend-jack.js"
    },
    "./backend-pipewire": {
      "types": "./backend-pipewire.d.ts",
      "require": "./backend-pipewire.js",
      "default": "./backend-pipewire.js"
    },
    "./backend-pulseaudio": {
      "types": "./backend-pulseaudio.d.ts",
      "require": "./backend-pulseaudio.js",
      "default": "./backend-pulseaudio.js"
    },
    "./backend-asio": {
      "types": "./backend-asio.d.ts",
      "require": "./backend-asio.js",
      "default": "./backend-asio.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:types && npm run test:rust",
    "test:unit": "mocha \"tests/unit/**/*.test.js\" --timeout 5000",
    "test:types": "tsc --project tests/types/tsconfig.json",
    "test:rust": "cargo test --lib",
    "test:audio": "mocha \"tests/audio/**/*.test.js\" --timeout 10000",
    "test:stress": "mocha \"tests/stress/**/*.test.js\" --timeout 20000",
    "test:hardware": "npm run test:audio && npm run test:stress",
    "benchmark:audio": "mocha \"tests/benchmarks/**/*.benchmark.js\" --timeout 20000",
    "cargo-build": "cargo build --message-format=json-render-diagnostics > cargo.log",
    "cross-build": "cross build --message-format=json-render-diagnostics > cross.log",
    "postcargo-build": "neon dist < cargo.log",
    "postcross-build": "neon dist -m /target --manifest-path Cargo.toml < cross.log",
    "debug": "npm run cargo-build --",
    "build": "npm run cargo-build -- --release",
    "cross": "npm run cross-build -- --release"
  },
  "keywords": [
    "audio",
    "cpal",
    "sound",
    "native",
    "bindings"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@neon-rs/cli": "0.2.6",
    "@types/node": "^22.20.1",
    "mocha": "^11.8.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saeta-eth/node-cpal.git"
  },
  "bugs": {
    "url": "https://github.com/saeta-eth/node-cpal/issues"
  },
  "homepage": "https://github.com/saeta-eth/node-cpal#readme",
  "files": [
    "index.js",
    "index.d.ts",
    "facade.js",
    "backend-*.js",
    "backend-*.d.ts",
    "cpal-values.js",
    "docs/**/*",
    "bin/**/*",
    "examples/**/*",
    "README.md"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}
