node_modules/
# The vendored dsh-orb runtime ships its own dependencies (koffi, sherpa-onnx,
# node-cpal, zod...) at its package root, which is where its host looks for
# them. Re-include that one tree; everything else named node_modules stays out.
!vendor/dsh-orb/node_modules/
!vendor/dsh-orb/node_modules/**
dist/
build/
__pycache__/
*.pyc
*.log
.env
.env.*
.DS_Store
Thumbs.db
assets/promo/src/
assets/promo/frames/
assets/promo/stills/
assets/promo/check/
assets/promo/whalego-promo-video.mp4
assets/promo/whalego-promo-audio.wav
*.tmp
*.bak
artifacts/
docs/对话纪要.md
shots-*/
tools/live/shots-*/
tools/live/orb-candidates.png
# Agent/development probes stay local; the public repo ships product only.
tools/smoke-agent.mjs
tools/live/probe*.mjs

film/node_modules/
film/out/
film/.remotion/
